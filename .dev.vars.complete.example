# ==============================================================================
# COMPLETE ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .dev.vars.development/.dev.vars.test/.dev.vars.staging
# and update with your specific environment values
# ==============================================================================

# ==============================================================================
# 🔐 SECURITY & JWT CONFIGURATION
# ==============================================================================
JWT_SECRET = "your-super-secure-jwt-secret-key-here-minimum-32-characters"
JWT_ACCESS_TOKEN_EXPIRES = "3600"          # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES = "259200"       # 3 days in seconds
JWT_ISSUER = "hono-auth-worker"            # Token issuer
JWT_AUDIENCE = "hono-auth-client"          # Comma-separated list of allowed audiences
JWT_SCOPE_SEPARATOR = " "                   # Scope separator
JWT_SUBJECT_PREFIX = "user"                # Subject prefix
JWT_MAX_ACCESS_TOKEN_LIFETIME = "7200"     # Max allowed access token lifetime (seconds)
JWT_ENFORCE_ISSUER = "true"                # Enforce issuer validation
JWT_ENFORCE_AUDIENCE = "true"              # Enforce audience validation
JWT_ALLOWED_CLOCK_SKEW = "10"              # Allowed clock skew (seconds)
JWT_DEFAULT_SCOPE = "user:basic"           # Default scope

# Token security & binding
MAX_REFRESH_TOKENS_PER_USER = "5"          # Max active refresh tokens per user
REFRESH_TOKEN_REUSE_GRACE_SECONDS = "30"   # Grace window for reuse detection (seconds)
STRICT_IP_BINDING = "false"                # Convenience toggle for IP binding defaults
ENFORCE_ACCESS_TOKEN_IP_BINDING = "false"  # Enforce IP binding on access token
ENFORCE_ACCESS_TOKEN_UA_BINDING = "false"  # Enforce User-Agent binding on access token
ENFORCE_REFRESH_TOKEN_IP_BINDING = "false" # Enforce IP binding on refresh token
ENFORCE_REFRESH_TOKEN_UA_BINDING = "false" # Enforce User-Agent binding on refresh token

# ==============================================================================
# 🚦 RATE LIMITING CONFIGURATION  
# ==============================================================================
RATE_LIMIT_MAX_ATTEMPTS = "5"              # Maximum failed login attempts
RATE_LIMIT_LOCKOUT_DURATION = "120"        # Lockout duration in minutes (2 hours)

# ==============================================================================
# 🔑 PASSWORD HASHING CONFIGURATION
# ==============================================================================
BCRYPT_SALT_ROUNDS = "12"                  # bcrypt salt rounds (10-12 recommended)

# ==============================================================================
# 🌐 CORS CONFIGURATION
# ==============================================================================
CORS_ORIGIN = "*"                          # Allowed origins (use specific domains in production)
CORS_ALLOW_METHODS = "GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOW_HEADERS = "Content-Type,Authorization,Accept-Language"

# ==============================================================================
# 📄 PAGINATION CONFIGURATION
# ==============================================================================
DEFAULT_PAGE_SIZE = "10"                   # Default number of items per page
MAX_PAGE_SIZE = "100"                      # Maximum items per page

# ==============================================================================
# ⏰ METRICS & ANALYTICS TIME RANGES
# ==============================================================================
METRICS_RECENT_HOURS = "24"                # Recent activity tracking (hours)
METRICS_WEEKLY_DAYS = "7"                  # Weekly statistics (days)
METRICS_MONTHLY_DAYS = "30"                # Monthly statistics (days)  
METRICS_QUARTERLY_DAYS = "90"              # Quarterly statistics (days)

# ==============================================================================
# 🛡️ SECURITY THRESHOLDS
# ==============================================================================
SECURITY_HIGH_RISK_THRESHOLD = "10"        # Failed attempts threshold for high risk
PERFORMANCE_GOOD_THRESHOLD = "1000"        # Response time threshold for good performance (ms)

# ==============================================================================
# 🎛️ APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME = "Hono Auth API"
APP_VERSION = "1.0.0"
APP_URL = "https://your-app.com"            # Base URL for emails/links
ENV = "development"                         # Environment: development/test/staging/production
ENVIRONMENT = "development"                 # Optional alias

# ==============================================================================
# 🐛 DEBUG CONFIGURATION
# ==============================================================================
# Available debug namespaces:
# - "hono-auth-api:*"           = All debug logs (full debug mode)
# - "hono-auth-api:routes:*"    = Only route logs
# - "hono-auth-api:security:*"  = Only security logs  
# - "hono-auth-api:error:*"     = Only error logs
# - "hono-auth-api:validation:*"= Only validation logs
# - "hono-auth-api:i18n:*"      = Only i18n logs
# - "hono-auth-api:database:*"  = Only database logs
# - "hono-auth-api:services:*"  = Only service logs
# - "hono-auth-api:middleware:*"= Only middleware logs
# - ""                          = No debug logs (silent mode)
DEBUG = "hono-auth-api:*"

# ==============================================================================
# 👤 USER MANAGEMENT CONFIGURATION
# ==============================================================================
AUTO_ACTIVATE_USER_ON_REGISTER = "false"   # Auto-activate users on registration
MAINTENANCE_MODE = "false"                 # Put API into maintenance mode

# Response logging control
ENABLE_RESPONSE_BODY_CAPTURE = "false"     # Enable only for debugging (super_admin controlled)

# ==============================================================================
# 🔧 DEVELOPMENT/TEST SPECIFIC SETTINGS
# ==============================================================================
# Uncomment these for development/testing
# RATE_LIMIT_DISABLED = "true"           # Disable rate limiting for testing
# ENABLE_DETAILED_ERRORS = "true"          # Show detailed error messages
# LOG_SQL_QUERIES = "true"                 # Log all SQL queries for debugging

# ==============================================================================
# 📧 EMAIL DELIVERY SETTINGS
# ==============================================================================
EMAIL_ENABLED = "false"                     # Master switch for all emails
EMAIL_CONFIRMATION_ENABLED = "false"        # Send registration confirmation emails
EMAIL_FROM_ADDRESS = "no-reply@hono-auth.local"
EMAIL_FROM_NAME = "Hono Auth API"
EMAIL_REPLY_TO = ""
EMAIL_PROVIDER = "brevo"                    # mailchannels | brevo | custom
EMAIL_PROVIDER_ENDPOINT = "https://api.brevo.com/v3/smtp/email"
EMAIL_PROVIDER_API_KEY = ""                 # Required if provider needs API key
EMAIL_PROVIDER_AUTH_HEADER = "api-key"      # Auth header name for provider

# ==============================================================================
# 🛡️ SECURITY HEADERS (override defaults only if needed)
# ==============================================================================
SECURITY_X_CONTENT_TYPE_OPTIONS = "nosniff"
SECURITY_X_FRAME_OPTIONS = "DENY"
SECURITY_X_XSS_PROTECTION = "1; mode=block"
SECURITY_CSP = "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'"
SECURITY_REFERRER_POLICY = "strict-origin-when-cross-origin"
SECURITY_PERMISSIONS_POLICY = "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()"
SECURITY_COOP = "same-origin"
SECURITY_COEP = "require-corp"
SECURITY_CORP = "same-origin"
SECURITY_X_DOWNLOAD_OPTIONS = "noopen"
SECURITY_X_PERMITTED_CDP = "none"
SECURITY_HSTS = "max-age=31536000; includeSubDomains; preload"  # Enable only over HTTPS

# ==============================================================================
# 📊 ENTERPRISE AUDIT SYSTEM CONFIGURATION
# ======================================================================
# Retention Policies
AUDIT_DEFAULT_RETENTION_DAYS = "90"
AUDIT_SENSITIVE_RETENTION_DAYS = "365"
AUDIT_COMPLIANCE_RETENTION_DAYS = "2555"       # ~7 years
AUDIT_AUTO_ARCHIVE_ENABLED = "true"
AUDIT_AUTO_ARCHIVE_THRESHOLD_DAYS = "30"

# Performance Settings
AUDIT_MAX_QUERY_RESULTS = "1000"
AUDIT_DEFAULT_PAGE_SIZE = "50"
AUDIT_MAX_PAGE_SIZE = "500"
AUDIT_QUERY_TIMEOUT_MS = "30000"
AUDIT_BATCH_SIZE = "100"

# Alert Thresholds
AUDIT_FAILED_LOGIN_THRESHOLD = "5"
AUDIT_SUSPICIOUS_ACTIVITY_THRESHOLD = "10"
AUDIT_HIGH_RISK_ACTION_THRESHOLD = "3"
AUDIT_PERFORMANCE_ALERT_THRESHOLD_MS = "5000"

# Feature Toggles
AUDIT_ENABLE_REAL_TIME_MONITORING = "true"
AUDIT_ENABLE_ADVANCED_ANALYTICS = "true"
AUDIT_ENABLE_EXPORT = "true"
AUDIT_ENABLE_ARCHIVAL = "true"
AUDIT_ENABLE_COMPLIANCE_REPORTING = "true"
AUDIT_ENABLE_PERFORMANCE_MONITORING = "true"
AUDIT_ENABLE_ADVANCED_SEARCH = "true"

# Real-time Monitoring
AUDIT_REALTIME_BUFFER_SIZE = "1000"
AUDIT_REALTIME_FLUSH_INTERVAL_MS = "5000"
AUDIT_REALTIME_MAX_CONNECTIONS = "100"
AUDIT_THREAT_DETECTION_ENABLED = "true"

# Export Configuration
AUDIT_EXPORT_MAX_RECORDS = "10000"
AUDIT_EXPORT_ALLOWED_FORMATS = "csv,json,excel"
AUDIT_EXPORT_TIMEOUT_MS = "120000"
AUDIT_EXPORT_COMPRESSION_ENABLED = "true"

# Analytics Settings
AUDIT_ANALYTICS_CACHE_TTL_MS = "300000"
AUDIT_ANALYTICS_MAX_TIME_RANGE_DAYS = "365"
AUDIT_ANALYTICS_ENABLE_BEHAVIORAL = "true"
AUDIT_ANALYTICS_ENABLE_SECURITY = "true"

# Security Incident Management
AUDIT_INCIDENT_AUTO_DETECTION_ENABLED = "true"
AUDIT_INCIDENT_RESPONSE_TIMEOUT_MS = "60000"
AUDIT_INCIDENT_MAX_SEVERITY_LEVEL = "5"
AUDIT_INCIDENT_EMAIL_NOTIFICATIONS_ENABLED = "false"

# Compliance Settings
AUDIT_COMPLIANCE_GDPR_ENABLED = "true"
AUDIT_COMPLIANCE_SOX_ENABLED = "false"
AUDIT_COMPLIANCE_HIPAA_ENABLED = "false"
AUDIT_COMPLIANCE_AUTO_REPORT_ENABLED = "false"

# ==============================================================================
# 📝 NOTES
# ==============================================================================
# 1. For production, use strong secrets and set appropriate rate limits
# 2. CORS_ORIGIN should be specific domains in production, not "*"  
# 3. Increase BCRYPT_SALT_ROUNDS for better security (12-14) but slower performance
# 4. Adjust time ranges based on your analytics needs
# 5. Set DEBUG to empty string "" or specific namespaces in production

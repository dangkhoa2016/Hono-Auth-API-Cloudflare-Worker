    "tool:schema:validate": "node tools/schema-registry-demo.js validate",
    "tool:schema:demo": "node tools/schema-registry-demo.js demo",
    "tool:debug": "node tools/debug_log/comprehensive_debug_test.js",
    "tool:debug:run": "bash tools/debug_log/run_comprehensive_test.sh",
    "tool:i18n:cleanup": "node tools/i18n/cleanup-unused-keys.js --prefix-stats",
    "tool:i18n:cleanup:fix": "node tools/i18n/cleanup-unused-keys.js --fix --backup --prefix-stats",
    "tool:i18n:cleanup:report": "node tools/i18n/cleanup-unused-keys.js --report",
    "tool:i18n:cleanup:help": "node tools/i18n/cleanup-unused-keys.js -h",
    "tool:i18n:cleanup:aggressive": "node tools/i18n/cleanup-unused-keys.js --aggressive --prefix-stats",
    "tool:i18n:cleanup:aggressive:fix": "node tools/i18n/cleanup-unused-keys.js --fix --backup --aggressive --prefix-stats",
    "tool:i18n:cleanup:validation": "node tools/i18n/cleanup-unused-keys.js --only-prefix validation. --prefix-stats",
    "tool:i18n:cleanup:validation:fix": "node tools/i18n/cleanup-unused-keys.js --only-prefix validation. --fix --backup --prefix-stats",
    "tool:i18n:cleanup:endpoints": "node tools/i18n/cleanup-unused-keys.js --only-prefix endpoints. --prefix-stats",
    "tool:i18n:cleanup:endpoints:fix": "node tools/i18n/cleanup-unused-keys.js --only-prefix endpoints. --fix --backup --prefix-stats",
    "tool:i18n:sort": "node tools/i18n/sort-i18n-keys.js",
    "tool:i18n:sort:fix": "node tools/i18n/sort-i18n-keys.js --fix --backup",

{
  "name": "hono-auth-api-worker",
  "version": "1.0.0",
  "description": "Hono.js authentication worker with Cloudflare D1",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --env development --port 8787",
    "dev:debug": "wrangler dev --env development --port 8787 --log-level debug",
    "dev:log": "wrangler dev --env development --port 8787 --log-level log",
    "dev:info": "wrangler dev --env development --port 8787 --log-level info",
    "dev:warn": "wrangler dev --env development --port 8787 --log-level warn",
    "dev:error": "wrangler dev --env development --port 8787 --log-level error",
    "dev:silent": "wrangler dev --env development --port 8787 --log-level none",
    "dev:test": "wrangler dev --env test --port 8788 --log-level info",
    "dev:test:debug": "wrangler dev --env test --port 8788 --log-level debug",
    "dev:test:log": "wrangler dev --env test --port 8788 --log-level log",
    "dev:test:warn": "wrangler dev --env test --port 8788 --log-level warn",
    "dev:test:error": "wrangler dev --env test --port 8788 --log-level error",
    "dev:test:silent": "wrangler dev --env test --port 8788 --log-level none",
    "dev:staging": "wrangler dev --env staging --remote --port 8789 --log-level warn",
    "dev:staging:debug": "wrangler dev --env staging --remote --port 8789 --log-level debug",
    "dev:staging:log": "wrangler dev --env staging --remote --port 8789 --log-level log",
    "dev:staging:info": "wrangler dev --env staging --remote --port 8789 --log-level info",
    "dev:staging:error": "wrangler dev --env staging --remote --port 8789 --log-level error",
    "dev:staging:silent": "wrangler dev --env staging --remote --port 8789 --log-level none",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "db:migrate": "CI=true NO_D1_WARNING=true wrangler d1 migrations apply hono-auth-api-db-development --local --env development",
    "db:migrate:test": "CI=true NO_D1_WARNING=true wrangler d1 migrations apply hono-auth-api-db-test --local --env test",
    "db:migrate:staging": "wrangler d1 migrations apply hono-auth-api-db-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply hono-auth-api-db --remote",
    "setup:dev": "bash scripts/setup-dev.sh",
    "setup:test": "bash scripts/setup-test.sh",
    "setup:staging": "bash scripts/setup-staging.sh",
    "db:create:staging": "wrangler d1 create hono-auth-api-db-staging",
    "db:create:prod": "wrangler d1 create hono-auth-api-db",
    "secret:put:staging": "wrangler secret put JWT_SECRET --env staging",
    "secret:put:prod": "wrangler secret put JWT_SECRET",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "lint:check": "eslint src/ tests/ --ext .js --max-warnings 0",
    "kill": "pkill -f 'wrangler dev' || true",
    "test:kv:setup": "node tests/init/reset_kv.js",
    "test:initdb": "yarn test:kv:setup && wrangler d1 execute hono-auth-api-db-test --local --env test --file tests/init/reset.sql",
    "test:unified": "yarn test:initdb && node tests/unifiedTestSuite.js all",
    "test:unified:all": "yarn test:initdb && node tests/unifiedTestSuite.js all",
    "test:unified:quick": "node tests/unifiedTestSuite.js quick",
    "test:unified:system": "node tests/unifiedTestSuite.js system",
    "test:unified:auth": "node tests/unifiedTestSuite.js auth",
    "test:unified:user": "node tests/unifiedTestSuite.js user",
    "test:unified:admin": "node tests/unifiedTestSuite.js admin",
    "test:unified:superadmin": "node tests/unifiedTestSuite.js superadmin",
    "test:unified:rbac": "node tests/unifiedTestSuite.js rbac",
    "test:unified:security": "node tests/unifiedTestSuite.js security",
    "test:unified:kv": "node tests/unifiedTestSuite.js kv",
    "test:unified:translation": "node tests/unifiedTestSuite.js translation",
    "test:optimized": "node tests/optimizedServiceTest.js",
    "test:unified:performance": "node tests/unifiedTestSuite.js performance",
    "test:unified:help": "node tests/unifiedTestSuite.js help",
    "test": "yarn test:initdb && node tests/mainMenu.js",
    "test:simple": "node tests/simpleTest.js",
    "test:system": "node tests/systemTest.js",
    "test:auth": "node tests/authTest.js",
    "test:kv:admin": "node tests/kvAdminTest.js",
    "test:kv:audit": "node tests/kvAuditConfigTest.js",
    "test:audit:integration": "node tests/auditLogServiceIntegrationTest.js",
    "test:security": "node tests/securityTest.js",
    "test:security:incident": "node tests/securityIncidentTest.js",
    "test:i18n": "node tests/comprehensiveI18nTest.js",
    "test:translation": "node tests/comprehensiveI18nTest.js",
    "test:i18n:missing": "node tests/missingTranslationTest.js",
    "test:role": "node tests/roleTest.js",
    "test:performance": "node tests/performanceTest.js",
    "test:integration": "node tests/integrationTest.js",
    "test:validation": "node tests/validationTest.js",
    "test:error": "node tests/errorHandlingTest.js",
    "test:zod_validation": "node tests/zodValidationTest.js",
    "test:multilang_validation": "node tests/multiLanguageValidationErrorTest.js",
    "test:multilang:script": "bash tests/scripts/test-multilang-validation.sh",
    "test:xss": "node tests/xssSecurityTest.js",
    "test:xss:all": "node tests/xssSecurityTest.js all",
    "test:xss:login": "node tests/xssSecurityTest.js login",
    "test:xss:profile": "node tests/xssSecurityTest.js profile",
    "test:xss:creation": "node tests/xssSecurityTest.js creation",
    "test:xss:search": "node tests/xssSecurityTest.js search",
    "test:quick": "node tests/quickTest.js",
    "test:admin_user": "node tests/adminUserTest.js",
    "test:super_admin_user": "node tests/superAdminUserTest.js",
    "test:regular_user": "node tests/regularUserTest.js",
    "test:admin:i18n": "node tests/adminMessageTranslationTest.js",
    "test:admin:messages:script": "bash tests/scripts/test-admin-messages.sh",
    "test:kv_admin": "node tests/kvAdminTest.js",
    "test:kv:scripts": "yarn test:kv:setup && bash tests/scripts/test-kv-admin.sh",
    "test:kv:audit:config": "bash tests/scripts/test-kv-audit-config.sh",
    "test:audit:simple": "node tests/simpleAuditTest.js all",
    "test:audit:simple:quick": "node tests/simpleAuditTest.js quick",
    "test:audit:advanced-js": "node tests/advancedAuditComprehensiveTest.js",
    "test:audit:advanced-js:help": "node tests/advancedAuditComprehensiveTest.js help",
    "test:audit:advanced-js:all": "node tests/advancedAuditComprehensiveTest.js all",

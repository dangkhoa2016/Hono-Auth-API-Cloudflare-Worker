    "@hono/zod-validator": "^0.7.0",
    "bcryptjs": "^2.4.3",
    "debug": "^4.4.1",
    "hono": "^4.0.0",
    "i18next": "^25.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "wrangler": "^4.22.0"
  }

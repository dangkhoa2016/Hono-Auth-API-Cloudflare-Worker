    "test:audit:advanced-js:middleware": "node tests/advancedAuditComprehensiveTest.js middleware",
    "test:audit:advanced-js:functional": "node tests/advancedAuditComprehensiveTest.js functional",
    "test:audit:advanced-js:security": "node tests/advancedAuditComprehensiveTest.js security",
    "test:audit:advanced-js:validation": "node tests/advancedAuditComprehensiveTest.js validation",
    "test:audit:advanced-js:errors": "node tests/advancedAuditComprehensiveTest.js errors",
    "test:audit:advanced-js:edge": "node tests/advancedAuditComprehensiveTest.js edge",
    "test:audit:advanced-js:performance": "node tests/advancedAuditComprehensiveTest.js performance",
    "test:audit:advanced-js:additional": "node tests/advancedAuditComprehensiveTest.js additional",
    "test:audit:advanced-js:quick": "node tests/advancedAuditComprehensiveTest.js quick",
    "test:audit:perf": "node tests/auditPerformanceTest.js",
    "test:audit:archival": "node tests/archivalServiceTest.js",
    "test:audit": "bash tests/scripts/unified-audit-test.sh full",
    "test:audit:quick": "bash tests/scripts/unified-audit-test.sh quick",
    "test:audit:performance": "bash tests/scripts/unified-audit-test.sh performance",
    "test:audit:comprehensive": "bash tests/scripts/unified-audit-test.sh comprehensive",
    "test:audit:core": "bash tests/scripts/unified-audit-test.sh core",
    "test:audit:advanced": "bash tests/scripts/unified-audit-test.sh advanced",
    "test:audit:realtime": "bash tests/scripts/unified-audit-test.sh realtime",
    "test:audit:system": "bash tests/scripts/unified-audit-test.sh system",
    "test:audit:runner:help": "bash tests/scripts/unified-audit-test.sh help",
    "test:audit:endpoints": "bash tests/scripts/unified-audit-test.sh endpoints",
    "test:audit:monitoring": "bash tests/scripts/unified-audit-test.sh realtime",
    "test:audit:js:core": "bash tests/scripts/unified-audit-test.sh js-core",
    "test:audit:js:advanced": "bash tests/scripts/unified-audit-test.sh js-advanced",
    "test:audit:js:realtime": "bash tests/scripts/unified-audit-test.sh js-realtime",

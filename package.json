    "test:audit:advanced-js:analytics": "node tests/advancedAuditComprehensiveTest.js analytics",
    "test:audit:advanced-js:archival": "node tests/advancedAuditComprehensiveTest.js archival",
    "test:audit:advanced-js:compliance": "node tests/advancedAuditComprehensiveTest.js compliance",
